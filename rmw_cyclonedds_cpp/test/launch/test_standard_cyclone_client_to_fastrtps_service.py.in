import os
import unittest

from launch import LaunchDescription
from launch.actions import ExecuteProcess

import launch_testing
import launch_testing.actions


def generate_test_description():
    server_env = dict(
        os.environ,
        RMW_IMPLEMENTATION="rmw_fastrtps_cpp",
        PHASE5_NODE_NAME="standard_fastrtps_param_server",
    )
    client_env = dict(
        os.environ,
        RMW_IMPLEMENTATION="rmw_cyclonedds_cpp",
        RMW_CYCLONEDDS_SERVICE_WIRE_MODE="standard",
        PHASE5_NODE_NAME="standard_cyclone_client",
        PHASE5_SERVICE_NAME="/standard_fastrtps_param_server/list_parameters",
        PHASE5_WAIT_SEC="15",
        PHASE5_TIMEOUT_SEC="10",
    )

    server = ExecuteProcess(
        cmd=["python3", "@TEST_HELPERS_DIR@/parameter_server_helper.py"],
        env=server_env,
        name="standard_fastrtps_param_server",
        output="screen",
    )
    client = ExecuteProcess(
        cmd=["@TEST_RCLCPP_LIST_PARAMETERS_CLIENT_EXECUTABLE@"],
        env=client_env,
        name="standard_cyclone_client",
        output="screen",
    )

    return LaunchDescription([
        server,
        client,
        launch_testing.actions.ReadyToTest(),
    ]), {"client_process": client}


class TestStandardCycloneClientToFastrtpsService(unittest.TestCase):

    def test_client_reports_success_and_exits(self, client_process, proc_output, proc_info):
        proc_output.assertWaitFor(
            "client_result=ok",
            process=client_process,
            stream="stdout",
            timeout=30,
        )
        proc_info.assertWaitForShutdown(process=client_process, timeout=30)


@launch_testing.post_shutdown_test()
class TestStandardCycloneClientToFastrtpsServiceAfterShutdown(unittest.TestCase):

    def test_client_exit_code(self, client_process, proc_info):
        self.assertEqual(proc_info[client_process].returncode, 0)
